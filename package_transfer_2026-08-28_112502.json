{
  "name": "nursemate",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "prepare:web": "node scripts/prepare-web.mjs",
    "build:admob": "esbuild src/admob.ts --bundle --format=iife --platform=browser --outfile=dist/nursemate-admob.js",
    "build": "npm run prepare:web && npm run build:admob && npx cap sync android",
    "android": "npm run build && npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "8.5.0",
    "@capacitor/core": "8.5.0",
    "@capacitor-community/admob": "8.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.0",
    "esbuild": "0.25.9"
  }
}